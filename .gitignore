# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase service account key
scripts/firebase-service-account.json

# Dream images — stored in Firebase Storage, not git
/public/images/dreams/

# Temp files
/temp

# Runtime hook logs
/logs

# Pipeline artifacts — regenerable, not needed for app
/data/images/
/data/validation/
/data/content/

# Local Claude settings override
.claude/settings.local.json
pipeline-status.html
