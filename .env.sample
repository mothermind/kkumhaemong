# Ad network wiring (see CLAUDE.md "Ads" section for the full contract).
# This file currently documents only the ad-related env vars added
# 2026-08-27; it does not yet cover the Firebase/Google API vars required
# elsewhere (see CLAUDE.md "Infrastructure" section for those).

# Master switch. Unset/false → AdSlot renders null everywhere, site is
# visually unchanged. Must be explicitly "true" to activate anything below.
NEXT_PUBLIC_ADS_ENABLED=false

# Kakao AdFit (fixed-size banner units only — no responsive/native unit).
# One unit id per slot; a missing id renders that slot as nothing (not a
# broken placeholder box). Sizes are fixed at the component level:
#   in-content-1 = 320x100, in-content-2 = 300x250, end = 250x250
# `end` is 250x250 (not 320x100) because AdFit allows only one unit per
# size per 매체 (media/site), and 320x100 is already used by in-content-1.
# AdSense's own in-article unit for `end` keeps 320x100 — the two networks
# now render different box dimensions for that one slot.
NEXT_PUBLIC_ADFIT_UNIT_IN_CONTENT_1=
NEXT_PUBLIC_ADFIT_UNIT_IN_CONTENT_2=
NEXT_PUBLIC_ADFIT_UNIT_END=

# Phase 2 CLS protection for AdFit — leave unset/false until AdFit clears
# 매체 심사 (media review). See CLAUDE.md "Ads" section for the two-phase
# rationale.
NEXT_PUBLIC_ADFIT_RESERVE_SPACE=false

# Google AdSense. Client id activates the site-wide loader script (consent-
# gated, /en/ + /ko/ fallback); per-slot ids activate the in-article units.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT_1=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT_2=
NEXT_PUBLIC_ADSENSE_SLOT_END=
